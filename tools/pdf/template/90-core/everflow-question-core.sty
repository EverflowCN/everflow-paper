% section 的最终换页值只在这里解析一次，避免三版共享一个默认来源。
% 旧全局值 true/false 的优先级最高；mode 或其他值表示按当前输出模式选择。
\def\Everflow@ResolvedSectionForceNewPage{false}
\newcommand{\Everflow@ResolveSectionForceNewPage}{%
  \ifdefstring{\EverflowSectionForceNewPage}{true}{%
    \def\Everflow@ResolvedSectionForceNewPage{true}%
  }{\ifdefstring{\EverflowSectionForceNewPage}{false}{%
    \def\Everflow@ResolvedSectionForceNewPage{false}%
  }{%
    \ifdefstring{\EverflowOutputKind}{public}{%
      \edef\Everflow@ResolvedSectionForceNewPage{\EverflowPublicSectionForceNewPage}%
    }{\ifdefstring{\EverflowOutputKind}{exam}{%
      \edef\Everflow@ResolvedSectionForceNewPage{\EverflowExamSectionForceNewPage}%
    }{%
      \edef\Everflow@ResolvedSectionForceNewPage{\EverflowBookSectionForceNewPage}%
    }}%
  }}%
}
\Everflow@ResolveSectionForceNewPage
% -------------------- 当前版式只决定题间空白 --------------------
\def\Everflow@QuestionLayoutMode{standard}
\def\Everflow@QuestionGap{\EverflowQuestionGapStandard}
\newif\ifEverflow@QuestionPageBreak
\Everflow@QuestionPageBreakfalse
\newcommand{\Everflow@ResolveQuestionMode}{%
  \def\Everflow@QuestionLayoutMode{standard}%
  \def\Everflow@QuestionGap{\EverflowQuestionGapStandard}%
  \Everflow@QuestionPageBreakfalse
  \ifdefstring{\EverflowOutputKind}{exam}{%
    \def\Everflow@QuestionLayoutMode{exam}%
    \def\Everflow@QuestionGap{\EverflowExamQuestionGap}%
  }{%
    \ifdefstring{\EverflowOutputKind}{public}{%
      \ifcsdef{EverflowPublicationLayout}{\edef\Everflow@QuestionLayoutMode{\csuse{EverflowPublicationLayout}}}{}%
    }{%
      % Book 直接读取类选项的字符串，避免数字映射顺序导致模式错位。
      \@ifundefined{@pageformat}{}{\edef\Everflow@QuestionLayoutMode{\@pageformat}}%
    }%
    \ifdefstring{\Everflow@QuestionLayoutMode}{compact}{\def\Everflow@QuestionGap{\EverflowQuestionGapCompact}}{}%
    \ifdefstring{\Everflow@QuestionLayoutMode}{standard}{\def\Everflow@QuestionGap{\EverflowQuestionGapStandard}}{}%
    \ifdefstring{\Everflow@QuestionLayoutMode}{loose}{\def\Everflow@QuestionGap{\EverflowQuestionGapLoose}}{}%
    \ifdefstring{\Everflow@QuestionLayoutMode}{single}{\def\Everflow@QuestionGap{0pt}\Everflow@QuestionPageBreaktrue}{}%
    \ifdefstring{\Everflow@QuestionLayoutMode}{padl}{\def\Everflow@QuestionGap{0pt}\Everflow@QuestionPageBreaktrue}{}%
    \ifdefstring{\Everflow@QuestionLayoutMode}{padp}{\def\Everflow@QuestionGap{0pt}\Everflow@QuestionPageBreaktrue}{}%
  }%
}

% -------------------- 题号与 qitems --------------------
\@ifundefined{c@QuestionCounter}{\newcounter{QuestionCounter}}{}
\newif\ifEverflow@QReset
\newif\ifEverflow@QShow
\def\Everflow@QPrefix{}
\def\Everflow@QSuffix{.}
\def\Everflow@QOptPrefix{(}
\def\Everflow@QOptSuffix{)}
\def\Everflow@QStartNum{0}
\define@key{qitems}{unreset}[true]{\Everflow@QResetfalse}
\define@key{qitems}{unshow}[true]{\Everflow@QShowfalse}
\define@key{qitems}{prefix}{\def\Everflow@QPrefix{#1}}
\define@key{qitems}{suffix}{\def\Everflow@QSuffix{#1}}
\define@key{qitems}{optprefix}{\def\Everflow@QOptPrefix{#1}}
\define@key{qitems}{optsuffix}{\def\Everflow@QOptSuffix{#1}}
\define@key{qitems}{startnum}{\def\Everflow@QStartNum{#1}}

\newlength\Everflow@QuestionListLeft
\newlength\Everflow@QuestionListRight
\newcommand{\Everflow@SetQuestionGrid}{%
  \setlength\Everflow@QuestionListLeft{\EverflowQuestionLeftIndent}%
  \setlength\Everflow@QuestionListRight{\EverflowQuestionRightIndent}%
  % Public 保留现有出版内容安全区，但不改变题目内部行距和选项距离。
  \ifdefstring{\EverflowOutputKind}{public}{%
    \ifcsdef{EverflowPublicationContentIndent}{\addtolength\Everflow@QuestionListLeft{\csuse{EverflowPublicationContentIndent}}}{}%
    \ifcsdef{EverflowPublicationContentRightIndent}{\addtolength\Everflow@QuestionListRight{\csuse{EverflowPublicationContentRightIndent}}}{}%
  }{}%
}

\newcommand{\Everflow@QItemsBegin}[1]{%
  \begingroup
  \Everflow@QResettrue \Everflow@QShowtrue
  \def\Everflow@QPrefix{}\def\Everflow@QSuffix{.}%
  \def\Everflow@QOptPrefix{(}\def\Everflow@QOptSuffix{)}\def\Everflow@QStartNum{0}%
  \setkeys{qitems}{#1}%
  \ifEverflow@QReset\setcounter{QuestionCounter}{0}\fi
  \ifnum\Everflow@QStartNum>0\relax
    \setcounter{QuestionCounter}{\Everflow@QStartNum}\addtocounter{QuestionCounter}{-1}%
  \fi
  \Everflow@SetQuestionGrid
}
\newcommand{\Everflow@QItemsEnd}{\endgroup}
\@ifundefined{qitems}{%
  \NewDocumentEnvironment{qitems}{O{}}{\Everflow@QItemsBegin{#1}}{\Everflow@QItemsEnd}%
}{%
  \RenewDocumentEnvironment{qitems}{O{}}{\Everflow@QItemsBegin{#1}}{\Everflow@QItemsEnd}%
}

\newcommand{\Everflow@QuestionLabel}[1]{\makebox[\EverflowQuestionLabelWidth][r]{#1}}
\newif\ifEverflow@QuestionItemOpen
\newcommand{\Everflow@OpenQuestionItem}[1]{%
  \ifEverflow@QuestionItemOpen\end{list}\fi
  \begin{list}{}{%
    \setlength{\leftmargin}{\dimexpr\Everflow@QuestionListLeft+\EverflowQuestionLabelWidth+\EverflowQuestionLabelSep\relax}%
    \setlength{\rightmargin}{\Everflow@QuestionListRight}%
    \setlength{\labelwidth}{\EverflowQuestionLabelWidth}%
    \setlength{\labelsep}{\EverflowQuestionLabelSep}%
    \setlength{\itemindent}{0pt}\setlength{\listparindent}{0pt}%
    \setlength{\itemsep}{0pt}\setlength{\parsep}{0pt}%
    \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
  }%
  \item[\Everflow@QuestionLabel{#1}]\Everflow@QuestionItemOpentrue
}
\@ifundefined{qitem}{%
  \NewDocumentCommand{\qitem}{O{} O{}}{%
    \stepcounter{QuestionCounter}%
    \ifEverflow@QShow
      \Everflow@OpenQuestionItem{#1\Everflow@QPrefix\arabic{QuestionCounter}\Everflow@QSuffix#2}%
    \else
      \Everflow@OpenQuestionItem{#1\Everflow@QPrefix\Everflow@QSuffix#2}%
    \fi\ignorespaces}
}{%
  \RenewDocumentCommand{\qitem}{O{} O{}}{%
    \stepcounter{QuestionCounter}%
    \ifEverflow@QShow
      \Everflow@OpenQuestionItem{#1\Everflow@QPrefix\arabic{QuestionCounter}\Everflow@QSuffix#2}%
    \else
      \Everflow@OpenQuestionItem{#1\Everflow@QPrefix\Everflow@QSuffix#2}%
    \fi\ignorespaces}
}

% -------------------- bbox：单次装箱、测量、直接复用 --------------------
\newbox\Everflow@QuestionBox
\newdimen\Everflow@QuestionHeight
\newif\ifEverflow@KeepCurrentQuestion
\Everflow@KeepCurrentQuestiontrue
\newif\ifEverflow@ThisQuestionBoxed
\newcommand{\Everflow@QuestionAfter}{%
  \ifEverflow@QuestionPageBreak\newpage\else\par\addvspace{\Everflow@QuestionGap}\fi}
\newcommand{\Everflow@BBoxBegin}[1]{%
  \Everflow@HeadingFirstBlockBegin
  \par\begingroup
  \Everflow@QuestionItemOpenfalse
  \Everflow@ResolveQuestionMode
  \Everflow@ThisQuestionBoxedfalse
  \ifdefstring{\EverflowKeepQuestionWithChoices}{true}{%
    \ifEverflow@KeepCurrentQuestion\Everflow@ThisQuestionBoxedtrue\fi}{}%
  \ifEverflow@ThisQuestionBoxed
    \setbox\Everflow@QuestionBox=\vbox\bgroup
      \hsize=\linewidth\linewidth=\hsize\columnwidth=\hsize
      \setlength{\parindent}{0pt}\setlength{\emergencystretch}{2em}\ignorespaces
  \else
    \setlength{\emergencystretch}{2em}\ignorespaces
  \fi
}
\newcommand{\Everflow@BBoxEnd}{%
  \ifEverflow@QuestionItemOpen\end{list}\Everflow@QuestionItemOpenfalse\fi
  \ifEverflow@ThisQuestionBoxed
    \par\egroup
    \Everflow@QuestionHeight=\ht\Everflow@QuestionBox
    \advance\Everflow@QuestionHeight by \dp\Everflow@QuestionBox
    \ifdim\Everflow@QuestionHeight>\dimexpr\textheight-2\baselineskip\relax
      \PackageWarning{everflow-question-core}{Question \arabic{QuestionCounter} exceeds one page/column; policy=\EverflowOversizeQuestionPolicy; using safe breakable output}%
      \par\nobreak\unvbox\Everflow@QuestionBox
    \else
      \ifnum\Everflow@HeadingCaptureDepth>0\relax
        \par\nobreak\noindent\box\Everflow@QuestionBox
      \else
        \needspace{\dimexpr\Everflow@QuestionHeight+1pt\relax}%
        \noindent\box\Everflow@QuestionBox
      \fi
    \fi
  \else
    \par
  \fi
  \Everflow@HeadingFirstBlockEnd
  \Everflow@QuestionAfter
  \endgroup
}
\@ifundefined{bbox}{%
  \NewDocumentEnvironment{bbox}{O{}}{\Everflow@BBoxBegin{#1}}{\Everflow@BBoxEnd}%
}{%
  \RenewDocumentEnvironment{bbox}{O{}}{\Everflow@BBoxBegin{#1}}{\Everflow@BBoxEnd}%
}
\NewDocumentEnvironment{breakablebbox}{O{}}{%
  \begingroup\Everflow@KeepCurrentQuestionfalse\begin{bbox}[#1]
}{\end{bbox}\endgroup}
\newcommand{\EverflowKeepQuestionsOn}{\global\Everflow@KeepCurrentQuestiontrue}
\newcommand{\EverflowKeepQuestionsOff}{\global\Everflow@KeepCurrentQuestionfalse}

