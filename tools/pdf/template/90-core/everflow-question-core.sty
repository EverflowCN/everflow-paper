}{}

% -------------------- 选项：每个选项只测量一次 --------------------
\newlength\Everflow@ChoiceA \newlength\Everflow@ChoiceB \newlength\Everflow@ChoiceC
\newlength\Everflow@ChoiceD \newlength\Everflow@ChoiceE \newlength\Everflow@ChoiceF \newlength\Everflow@ChoiceMax
\newcommand{\Everflow@ChoiceCell}[2]{%
  \parbox[t]{\hsize}{\raggedright\arraybackslash
    \hangindent=\EverflowChoiceLabelWidth\hangafter=1
    \makebox[\EverflowChoiceLabelWidth][l]{\Everflow@QOptPrefix#1\Everflow@QOptSuffix}#2\strut}}
\newcommand{\Everflow@MeasureChoice}[3]{%
  \settowidth{#1}{\normalfont\Everflow@QOptPrefix#2\Everflow@QOptSuffix\ #3}%
  \ifdim#1>\Everflow@ChoiceMax\setlength\Everflow@ChoiceMax{#1}\fi}
\newcommand{\Everflow@ChoicesOne}[1]{%
  \par\vspace{\EverflowChoiceBeforeSkip}\noindent
  \begingroup\setlength{\tabcolsep}{0pt}\begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{}}#1\end{tabularx}\endgroup\par}
\newcommand{\Everflow@ChoicesTwo}[1]{%
  \par\vspace{\EverflowChoiceBeforeSkip}\noindent
  \begingroup\setlength{\tabcolsep}{0pt}\begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{\hspace{\EverflowChoiceColumnGap}}>{\raggedright\arraybackslash}X@{}}#1\end{tabularx}\endgroup\par}
\newcommand{\Everflow@ChoicesThree}[1]{%
  \par\vspace{\EverflowChoiceBeforeSkip}\noindent
  \begingroup\setlength{\tabcolsep}{0pt}\begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{\hspace{0.8em}}>{\raggedright\arraybackslash}X@{\hspace{0.8em}}>{\raggedright\arraybackslash}X@{}}#1\end{tabularx}\endgroup\par}
\newcommand{\Everflow@ChoicesFour}[1]{%
  \par\vspace{\EverflowChoiceBeforeSkip}\noindent
  \begingroup\setlength{\tabcolsep}{0pt}\begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{\hspace{0.55em}}>{\raggedright\arraybackslash}X@{\hspace{0.55em}}>{\raggedright\arraybackslash}X@{\hspace{0.55em}}>{\raggedright\arraybackslash}X@{}}#1\end{tabularx}\endgroup\par}
\newcommand{\Everflow@MeasureReset}{\setlength\Everflow@ChoiceMax{0pt}}

\newcommand{\Everflow@ThreeChoices}[3]{%
  \Everflow@MeasureReset
  \Everflow@MeasureChoice{\Everflow@ChoiceA}{A}{#1}\Everflow@MeasureChoice{\Everflow@ChoiceB}{B}{#2}\Everflow@MeasureChoice{\Everflow@ChoiceC}{C}{#3}%
  \ifdim\Everflow@ChoiceMax<\EverflowChoiceFourColumnThreshold\linewidth
    \Everflow@ChoicesThree{\Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}&\Everflow@ChoiceCell{C}{#3}}
  \else\ifdim\Everflow@ChoiceMax<\EverflowChoiceTwoColumnThreshold\linewidth
    \Everflow@ChoicesTwo{\Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}&}
  \else
    \Everflow@ChoicesOne{\Everflow@ChoiceCell{A}{#1}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}}
  \fi\fi}
\newcommand{\Everflow@FourChoices}[4]{%
  \Everflow@MeasureReset
  \Everflow@MeasureChoice{\Everflow@ChoiceA}{A}{#1}\Everflow@MeasureChoice{\Everflow@ChoiceB}{B}{#2}\Everflow@MeasureChoice{\Everflow@ChoiceC}{C}{#3}\Everflow@MeasureChoice{\Everflow@ChoiceD}{D}{#4}%
  \ifdim\Everflow@ChoiceMax<\EverflowChoiceFourColumnThreshold\linewidth
    \Everflow@ChoicesFour{\Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}&\Everflow@ChoiceCell{C}{#3}&\Everflow@ChoiceCell{D}{#4}}
  \else\ifdim\Everflow@ChoiceMax<\EverflowChoiceTwoColumnThreshold\linewidth
    \Everflow@ChoicesTwo{\Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}&\Everflow@ChoiceCell{D}{#4}}
  \else
    \Everflow@ChoicesOne{\Everflow@ChoiceCell{A}{#1}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{D}{#4}}
  \fi\fi}
\newcommand{\Everflow@FiveChoices}[5]{%
  \Everflow@MeasureReset
  \Everflow@MeasureChoice{\Everflow@ChoiceA}{A}{#1}\Everflow@MeasureChoice{\Everflow@ChoiceB}{B}{#2}\Everflow@MeasureChoice{\Everflow@ChoiceC}{C}{#3}\Everflow@MeasureChoice{\Everflow@ChoiceD}{D}{#4}\Everflow@MeasureChoice{\Everflow@ChoiceE}{E}{#5}%
  \ifdim\Everflow@ChoiceMax<\EverflowChoiceTwoColumnThreshold\linewidth
    \Everflow@ChoicesTwo{\Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}&\Everflow@ChoiceCell{D}{#4}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{E}{#5}&}
  \else
    \Everflow@ChoicesOne{\Everflow@ChoiceCell{A}{#1}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{D}{#4}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{E}{#5}}
  \fi}
\newcommand{\Everflow@SixChoices}[6]{%
  \Everflow@MeasureReset
  \Everflow@MeasureChoice{\Everflow@ChoiceA}{A}{#1}\Everflow@MeasureChoice{\Everflow@ChoiceB}{B}{#2}\Everflow@MeasureChoice{\Everflow@ChoiceC}{C}{#3}\Everflow@MeasureChoice{\Everflow@ChoiceD}{D}{#4}\Everflow@MeasureChoice{\Everflow@ChoiceE}{E}{#5}\Everflow@MeasureChoice{\Everflow@ChoiceF}{F}{#6}%
  \ifdim\Everflow@ChoiceMax<\EverflowChoiceFourColumnThreshold\linewidth
    \Everflow@ChoicesThree{\Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}&\Everflow@ChoiceCell{C}{#3}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{D}{#4}&\Everflow@ChoiceCell{E}{#5}&\Everflow@ChoiceCell{F}{#6}}
  \else\ifdim\Everflow@ChoiceMax<\EverflowChoiceTwoColumnThreshold\linewidth
    \Everflow@ChoicesTwo{\Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}&\Everflow@ChoiceCell{D}{#4}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{E}{#5}&\Everflow@ChoiceCell{F}{#6}}
  \else
    \Everflow@ChoicesOne{\Everflow@ChoiceCell{A}{#1}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{C}{#3}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{D}{#4}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{E}{#5}\\[\EverflowChoiceRowGap]\Everflow@ChoiceCell{F}{#6}}
  \fi\fi}
% 在线固定列数入口：列数已用同一在线字体离线测量。
% 这里用等宽 p 列直接渲染，避免 tabularx 的重复试排；列宽公式与原 X 列完全对应。
\newlength\Everflow@FastChoiceTwoWidth
\newlength\Everflow@FastChoiceFourWidth
\NewDocumentCommand{\fourchoicesone}{m m m m}{%
  \par\vspace{\EverflowChoiceBeforeSkip}\noindent
  \begingroup\setlength{\tabcolsep}{0pt}%
  \begin{tabular}{@{}p{\linewidth}@{}}
  \Everflow@ChoiceCell{A}{#1}\\[\EverflowChoiceRowGap]
  \Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]
  \Everflow@ChoiceCell{C}{#3}\\[\EverflowChoiceRowGap]
  \Everflow@ChoiceCell{D}{#4}
  \end{tabular}\endgroup\par}
\NewDocumentCommand{\fourchoicesfour}{m m m m}{%
  \setlength{\Everflow@FastChoiceFourWidth}{\dimexpr(\linewidth-1.65em)/4\relax}%
  \par\vspace{\EverflowChoiceBeforeSkip}\noindent
  \begingroup\setlength{\tabcolsep}{0pt}%
  \begin{tabular}{@{}p{\Everflow@FastChoiceFourWidth}@{\hspace{0.55em}}p{\Everflow@FastChoiceFourWidth}@{\hspace{0.55em}}p{\Everflow@FastChoiceFourWidth}@{\hspace{0.55em}}p{\Everflow@FastChoiceFourWidth}@{}}
  \Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}&\Everflow@ChoiceCell{C}{#3}&\Everflow@ChoiceCell{D}{#4}
  \end{tabular}\endgroup\par}
% 显式两列：等价于原 two-X 列宽，避免在线 tabularx 再试排。
\NewDocumentCommand{\fourchoicestwo}{m m m m}{%
  \setlength{\Everflow@FastChoiceTwoWidth}{\dimexpr(\linewidth-\EverflowChoiceColumnGap)/2\relax}%
  \par\vspace{\EverflowChoiceBeforeSkip}\noindent
  \begingroup\setlength{\tabcolsep}{0pt}%
  \begin{tabular}{@{}p{\Everflow@FastChoiceTwoWidth}@{\hspace{\EverflowChoiceColumnGap}}p{\Everflow@FastChoiceTwoWidth}@{}}
  \Everflow@ChoiceCell{A}{#1}&\Everflow@ChoiceCell{B}{#2}\\[\EverflowChoiceRowGap]
  \Everflow@ChoiceCell{C}{#3}&\Everflow@ChoiceCell{D}{#4}
  \end{tabular}\endgroup\par}
\@ifundefined{threechoices}{\NewDocumentCommand{\threechoices}{m m m}{\Everflow@ThreeChoices{#1}{#2}{#3}}}{\RenewDocumentCommand{\threechoices}{m m m}{\Everflow@ThreeChoices{#1}{#2}{#3}}}
\@ifundefined{fourchoices}{\NewDocumentCommand{\fourchoices}{m m m m}{\Everflow@FourChoices{#1}{#2}{#3}{#4}}}{\RenewDocumentCommand{\fourchoices}{m m m m}{\Everflow@FourChoices{#1}{#2}{#3}{#4}}}
\@ifundefined{fivechoices}{\NewDocumentCommand{\fivechoices}{m m m m m}{\Everflow@FiveChoices{#1}{#2}{#3}{#4}{#5}}}{\RenewDocumentCommand{\fivechoices}{m m m m m}{\Everflow@FiveChoices{#1}{#2}{#3}{#4}{#5}}}
\@ifundefined{fivechoicescompact}{\NewDocumentCommand{\fivechoicescompact}{m m m m m}{\Everflow@FiveChoices{#1}{#2}{#3}{#4}{#5}}}{\RenewDocumentCommand{\fivechoicescompact}{m m m m m}{\Everflow@FiveChoices{#1}{#2}{#3}{#4}{#5}}}
\@ifundefined{sixchoices}{\NewDocumentCommand{\sixchoices}{m m m m m m}{\Everflow@SixChoices{#1}{#2}{#3}{#4}{#5}{#6}}}{\RenewDocumentCommand{\sixchoices}{m m m m m m}{\Everflow@SixChoices{#1}{#2}{#3}{#4}{#5}{#6}}}

% -------------------- 所有标题统一防孤立 --------------------
% 算法说明：
% 1. 第一条受保护标题建立“标题链”；连续出现的其他标题继续加入同一条链。
% 2. 标题链结束前不允许在标题之间分页。
% 3. 第一项 bbox 会先完成装箱与高度测量，再与标题链无断点输出。
% 4. 第一项是普通正文时，使用 club penalties 至少保护指定行数。
% 5. Exam A3 的 column 模式使用 TeX 原生下一栏；page 模式在基础预留不足时
%    直接 clearpage，进入下一张 A3 物理页。
\newif\ifEverflow@InsideQuestionGroup
\Everflow@InsideQuestionGroupfalse
\newif\ifEverflow@SkipNextSectionForcePage
\Everflow@SkipNextSectionForcePagefalse
\newif\ifEverflow@HeadingChainActive
\Everflow@HeadingChainActivefalse
\newif\ifEverflow@HeadingParagraphProtected
\Everflow@HeadingParagraphProtectedfalse
\newcount\Everflow@HeadingRenderDepth
\Everflow@HeadingRenderDepth=0\relax
\newcount\Everflow@HeadingCaptureDepth
\Everflow@HeadingCaptureDepth=0\relax
\newcount\Everflow@SavedClubPenalty
\newdimen\Everflow@HeadingRemainingSpace

% 根据 A3 前进模式应用基础空间预留。
\newcommand{\Everflow@ReserveHeadingSpace}[1]{%
  \ifdefstring{\EverflowOutputKind}{exam}{%
    \ifdefstring{\EverflowPaper}{a3paper}{%
      \ifdefstring{\EverflowExamAThreeHeadingAdvance}{page}{%
        \par
        \ifdim\pagegoal<\maxdimen
          \Everflow@HeadingRemainingSpace=\pagegoal
          \advance\Everflow@HeadingRemainingSpace by -\pagetotal
          \ifdim\Everflow@HeadingRemainingSpace<#1\relax
            \clearpage
          \fi
        \else
          \needspace{#1}%
        \fi
      }{\needspace{#1}}%
    }{\needspace{#1}}%
  }{\needspace{#1}}%
}

% 开始一个新标题组，或者把当前标题并入已经存在的连续标题组。
\newcommand{\Everflow@HeadingPolicyStart}[3]{%
  \ifnum\Everflow@HeadingRenderDepth=0\relax
    \ifEverflow@HeadingChainActive
      \ifdefstring{\EverflowHeadingConsecutiveGroupControl}{true}{%
        \ifdefstring{\EverflowHeadingKeepWithNextControl}{true}{%
          \ifdefstring{#2}{true}{}{\global\Everflow@HeadingChainActivefalse}%
        }{\global\Everflow@HeadingChainActivefalse}%
      }{\global\Everflow@HeadingChainActivefalse}%
    \fi
    \ifEverflow@HeadingChainActive
      \par\nobreak
    \else
      \ifdefstring{#1}{true}{\clearpage}{}%
      \ifdefstring{\EverflowHeadingKeepWithNextControl}{true}{%
        \ifdefstring{#2}{true}{%
          \ifdefstring{#1}{true}{}{\Everflow@ReserveHeadingSpace{#3}}%
          \global\Everflow@HeadingChainActivetrue
        }{}%
      }{}%
    \fi
  \fi
  \global\advance\Everflow@HeadingRenderDepth by 1\relax
}

% 完成一条标题命令。最外层标题完成后，禁止在下一项标题或内容前断开。
\newcommand{\Everflow@HeadingPolicyFinish}{%
  \global\advance\Everflow@HeadingRenderDepth by -1\relax
  \ifnum\Everflow@HeadingRenderDepth<0\relax
    \global\Everflow@HeadingRenderDepth=0\relax
  \fi
  \ifnum\Everflow@HeadingRenderDepth=0\relax
    \ifEverflow@HeadingChainActive
      \par\nobreak
    \fi
  \fi
}

% 第一项完整内容块开始与结束。嵌套图片或表格使用计数器，避免过早结束标题链。
\newcommand{\Everflow@HeadingFirstBlockBegin}{%
  \ifnum\Everflow@HeadingRenderDepth=0\relax
    \ifEverflow@HeadingChainActive
      \global\advance\Everflow@HeadingCaptureDepth by 1\relax
      \par\nobreak
    \fi
  \fi
}
\newcommand{\Everflow@HeadingFirstBlockEnd}{%
  \ifnum\Everflow@HeadingCaptureDepth>0\relax
    \global\advance\Everflow@HeadingCaptureDepth by -1\relax
    \ifnum\Everflow@HeadingCaptureDepth=0\relax
      \global\Everflow@HeadingChainActivefalse
    \fi
  \fi
}

% 普通正文使用 1--5 行保护。超出范围时按 3 行处理。
\newcommand{\Everflow@SetHeadingClubPenalties}{%
  \ifcase\EverflowHeadingMinimumFollowLines\relax
    \clubpenalties 3 10000 10000 0\relax
  \or
    \clubpenalties 1 10000\relax
  \or
    \clubpenalties 2 10000 0\relax
  \or
    \clubpenalties 3 10000 10000 0\relax
  \or
    \clubpenalties 4 10000 10000 10000 0\relax
  \or
    \clubpenalties 5 10000 10000 10000 10000 0\relax
  \else
    \clubpenalties 3 10000 10000 0\relax
  \fi
}
\newcommand{\Everflow@ProtectFirstOrdinaryParagraph}{%
  \ifnum\Everflow@HeadingRenderDepth=0\relax
    \ifnum\Everflow@HeadingCaptureDepth=0\relax
      \ifEverflow@HeadingChainActive
        \global\Everflow@SavedClubPenalty=\clubpenalty
        \global\Everflow@HeadingParagraphProtectedtrue
        \Everflow@SetHeadingClubPenalties
        \global\Everflow@HeadingChainActivefalse
      \fi
    \fi
  \fi
}
\newcommand{\Everflow@RestoreFirstOrdinaryParagraph}{%
  \ifEverflow@HeadingParagraphProtected
    \clubpenalty=\Everflow@SavedClubPenalty
    \global\Everflow@HeadingParagraphProtectedfalse
  \fi
}

% 各标题类型的入口。questiongroup 内部调用 chapter 时通过深度计数自动合并。
\newcommand{\Everflow@QuestionGroupBegin}{%
  \Everflow@HeadingPolicyStart{\EverflowQuestionGroupForceNewPage}{\EverflowQuestionGroupKeepWithNext}{\EverflowQuestionGroupNeedSpace}%
  \global\Everflow@InsideQuestionGrouptrue
}
\newcommand{\Everflow@QuestionGroupEnd}{%
  \global\Everflow@InsideQuestionGroupfalse
  \ifdefstring{\EverflowOutputKind}{exam}{%
    \ifdefstring{\EverflowExamMergeQuestionGroupWithFirstSection}{true}{%
      \ifdefstring{\EverflowExamQuestionGroupMode}{standalone}{}{\global\Everflow@SkipNextSectionForcePagetrue}%
    }{}%
  }{}%
  \Everflow@HeadingPolicyFinish
}
\newcommand{\Everflow@PartHeadingBegin}{\Everflow@HeadingPolicyStart{\EverflowPartForceNewPage}{\EverflowPartKeepWithNext}{\EverflowPartNeedSpace}}
\newcommand{\Everflow@ChapterHeadingBegin}{\Everflow@HeadingPolicyStart{\EverflowChapterForceNewPage}{\EverflowChapterKeepWithNext}{\EverflowChapterNeedSpace}}
\newcommand{\Everflow@SectionHeadingBegin}{%
  \ifEverflow@SkipNextSectionForcePage
    \global\Everflow@SkipNextSectionForcePagefalse
    \Everflow@HeadingPolicyStart{false}{\EverflowSectionKeepWithNext}{\EverflowSectionNeedSpace}%
  \else
    \Everflow@HeadingPolicyStart{\Everflow@ResolvedSectionForceNewPage}{\EverflowSectionKeepWithNext}{\EverflowSectionNeedSpace}%
  \fi
}
\newcommand{\Everflow@SubsectionHeadingBegin}{\Everflow@HeadingPolicyStart{\EverflowSubsectionForceNewPage}{\EverflowSubsectionKeepWithNext}{\EverflowSubsectionNeedSpace}}
\newcommand{\Everflow@SubsubsectionHeadingBegin}{\Everflow@HeadingPolicyStart{\EverflowSubsubsectionForceNewPage}{\EverflowSubsubsectionKeepWithNext}{\EverflowSubsubsectionNeedSpace}}
\newcommand{\Everflow@PublicationUnitTitleBegin}{\Everflow@HeadingPolicyStart{\EverflowPublicationUnitTitleForceNewPage}{\EverflowPublicationUnitTitleKeepWithNext}{\EverflowPublicationUnitTitleNeedSpace}}
\newcommand{\Everflow@ExamSectionNoteBegin}{\Everflow@HeadingPolicyStart{\EverflowExamSectionNoteForceNewPage}{\EverflowExamSectionNoteKeepWithNext}{\EverflowSectionNoteNeedSpace}}

% Public 独立页面可使用这两个公开命令，把自定义页面标题接入同一套保护。
\newcommand{\EverflowProtectedPageTitleBegin}{%
  \Everflow@HeadingPolicyStart{false}{true}{\EverflowSectionNeedSpace}%
}
\newcommand{\EverflowProtectedPageTitleEnd}{\Everflow@HeadingPolicyFinish}

% 标准标题命令通常会被 ctex、titlesec 或上游类再次包装。
% 这里不使用 LaTeX 的通用 cmd/... 钩子，而是在文档开始时保存最终版本的原命令，
% 再按其公开参数形式做一层安全包装，避免目录、星号标题和可选短标题发生参数冲突。
\newcommand{\Everflow@InstallHeadingWrappers}{%
  \ifcsdef{part}{%
    \NewCommandCopy{\Everflow@OriginalPart}{\part}
    \RenewDocumentCommand{\part}{s o m}{%
      \Everflow@PartHeadingBegin
      \IfBooleanTF{##1}{%
        \Everflow@OriginalPart*{##3}%
      }{%
        \IfNoValueTF{##2}{\Everflow@OriginalPart{##3}}{\Everflow@OriginalPart[##2]{##3}}%
      }%
      \ifcsname EverflowDynamicHeadingUpdate\endcsname\EverflowDynamicHeadingUpdate{part}{##3}\fi
      \Everflow@HeadingPolicyFinish
    }%
  }{}%
  \ifcsdef{chapter}{%
    \NewCommandCopy{\Everflow@OriginalChapter}{\chapter}
    \RenewDocumentCommand{\chapter}{s o m}{%
      \Everflow@ChapterHeadingBegin
      \IfBooleanTF{##1}{%
        \Everflow@OriginalChapter*{##3}%
      }{%
        \IfNoValueTF{##2}{\Everflow@OriginalChapter{##3}}{\Everflow@OriginalChapter[##2]{##3}}%
      }%
      \ifcsname EverflowDynamicHeadingUpdate\endcsname\EverflowDynamicHeadingUpdate{chapter}{##3}\fi
      \Everflow@HeadingPolicyFinish
    }%
  }{}%
  \ifcsdef{section}{%
    \NewCommandCopy{\Everflow@OriginalSection}{\section}
    \RenewDocumentCommand{\section}{s o m}{%
      \Everflow@SectionHeadingBegin
      \IfBooleanTF{##1}{%
        \Everflow@OriginalSection*{##3}%
      }{%
        \IfNoValueTF{##2}{\Everflow@OriginalSection{##3}}{\Everflow@OriginalSection[##2]{##3}}%
      }%
      \ifcsname EverflowDynamicHeadingUpdate\endcsname\EverflowDynamicHeadingUpdate{section}{##3}\fi
      \Everflow@HeadingPolicyFinish
    }%
  }{}%
  \ifcsdef{subsection}{%
    \NewCommandCopy{\Everflow@OriginalSubsection}{\subsection}
    \RenewDocumentCommand{\subsection}{s o m}{%
      \Everflow@SubsectionHeadingBegin
      \IfBooleanTF{##1}{%
        \Everflow@OriginalSubsection*{##3}%
      }{%
        \IfNoValueTF{##2}{\Everflow@OriginalSubsection{##3}}{\Everflow@OriginalSubsection[##2]{##3}}%
      }%
      \ifcsname EverflowDynamicHeadingUpdate\endcsname\EverflowDynamicHeadingUpdate{subsection}{##3}\fi
      \Everflow@HeadingPolicyFinish
    }%
  }{}%
  \ifcsdef{subsubsection}{%
    \NewCommandCopy{\Everflow@OriginalSubsubsection}{\subsubsection}
    \RenewDocumentCommand{\subsubsection}{s o m}{%
      \Everflow@SubsubsectionHeadingBegin
      \IfBooleanTF{##1}{%
        \Everflow@OriginalSubsubsection*{##3}%
      }{%
        \IfNoValueTF{##2}{\Everflow@OriginalSubsubsection{##3}}{\Everflow@OriginalSubsubsection[##2]{##3}}%
      }%
      \ifcsname EverflowDynamicHeadingUpdate\endcsname\EverflowDynamicHeadingUpdate{subsubsection}{##3}\fi
      \Everflow@HeadingPolicyFinish
    }%
  }{}%
  \ifcsdef{questiongroup}{%
    \NewCommandCopy{\Everflow@OriginalQuestionGroup}{\questiongroup}
    \RenewDocumentCommand{\questiongroup}{o m O{} O{4.5cm}}{%
      % Exam: ship out the previous paper before updating the running question-group title.
      % This prevents the final page of one paper from receiving the next paper's footer title.
      \ifdefstring{\EverflowOutputKind}{exam}{\clearpage}{}%
      \Everflow@QuestionGroupBegin
      \IfNoValueTF{##1}{\Everflow@OriginalQuestionGroup{##2}[##3][##4]}{\Everflow@OriginalQuestionGroup[##1]{##2}[##3][##4]}%
      \Everflow@QuestionGroupEnd
    }%
  }{}%
  \ifcsdef{EverflowRenderPublicationUnitTitle}{%
    \NewCommandCopy{\Everflow@OriginalRenderPublicationUnitTitle}{\EverflowRenderPublicationUnitTitle}
    \RenewDocumentCommand{\EverflowRenderPublicationUnitTitle}{m}{%
      \Everflow@PublicationUnitTitleBegin
      \Everflow@OriginalRenderPublicationUnitTitle{##1}%
      \ifcsname EverflowDynamicHeadingUpdate\endcsname\EverflowDynamicHeadingUpdate{publicationunittitle}{##1}\fi
      \Everflow@HeadingPolicyFinish
    }%
  }{}%
  \ifcsdef{examsectionnote}{%
    \NewCommandCopy{\Everflow@OriginalExamSectionNote}{\examsectionnote}
    \RenewDocumentCommand{\examsectionnote}{m}{%
      \Everflow@ExamSectionNoteBegin
      \Everflow@OriginalExamSectionNote{##1}%
      \Everflow@HeadingPolicyFinish
    }%
  }{}%
}

\AtBeginDocument{%
  \Everflow@InstallHeadingWrappers

  % 第一项非浮动图片、表格、代码和公式块使用完整内容块保护。
  \forcsvlist{\Everflow@InstallHeadingCommandBlockHooks}{qimage,qimagecaption,qimagepair,qsideimage,qtwoimages,qthreeimages,imgin}%
  \forcsvlist{\Everflow@InstallHeadingEnvironmentBlockHooks}{qtable,figure,table,lstlisting,verbatim,equation,equation*,displaymath,align,align*,gather,gather*,multline,multline*}%

  % 普通正文至少保护 HeadingMinimumFollowLines 指定的开头行数。
  \AddToHook{para/begin}{\Everflow@ProtectFirstOrdinaryParagraph}%
  \AddToHook{para/end}{\Everflow@RestoreFirstOrdinaryParagraph}%
}

% 批量安装内容命令与内容环境钩子。
\newcommand{\Everflow@InstallHeadingCommandBlockHooks}[1]{%
  \ifcsdef{#1}{%
    \AddToHook{cmd/#1/before}{\Everflow@HeadingFirstBlockBegin}%
    \AddToHook{cmd/#1/after}{\Everflow@HeadingFirstBlockEnd}%
  }{}%
}
\newcommand{\Everflow@InstallHeadingEnvironmentBlockHooks}[1]{%
  \AddToHook{env/#1/before}{\Everflow@HeadingFirstBlockBegin}%
  \AddToHook{env/#1/after}{\Everflow@HeadingFirstBlockEnd}%
}


