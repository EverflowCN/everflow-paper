{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Everflow",
  "version": "1.3.0",
  "identifier": "top.evera.everflow",
  "mainBinaryName": "Everflow",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Everflow · LaTeX 工作台",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Everflow",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
